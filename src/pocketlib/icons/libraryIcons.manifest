# Manifest for src/pocketlib/icons/libraryIcons.h — regenerate with:
#   python3 freeink-sdk/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/pocketlib/icons/libraryIcons.manifest \
#     --svgdir freeink-sdk/libs/assets/Icons/lucide/icons \
#     --sizes 32 --out src/pocketlib/icons/libraryIcons.h
# then clang-format -i the output. Stock Lucide icons (ISC licence).
