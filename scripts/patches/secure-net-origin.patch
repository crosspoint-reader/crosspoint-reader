diff --git a/libs/network/SecureNet/include/HttpOrigin.h b/libs/network/SecureNet/include/HttpOrigin.h
new file mode 100644
index 0000000..742d2a7
--- /dev/null
+++ b/libs/network/SecureNet/include/HttpOrigin.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace freeink {
+
+struct HttpOrigin {
+  std::string scheme;
+  std::string host;
+  uint16_t port = 0;
+  size_t pathOffset = 0;
+};
+
+// The origin parser and transport must agree on the host receiving credentials.
+inline bool parseHttpOrigin(const std::string& url, HttpOrigin& origin) {
+  for (unsigned char c : url) {
+    if (c <= ' ' || c == 127) return false;
+  }
+  const size_t schemeEnd = url.find("://");
+  if (schemeEnd == std::string::npos) return false;
+  origin.scheme = url.substr(0, schemeEnd);
+  for (char& c : origin.scheme) {
+    if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+  }
+  if (origin.scheme != "http" && origin.scheme != "https") return false;
+  const size_t start = schemeEnd + 3;
+  const size_t end = url.find_first_of("/?#", start);
+  origin.pathOffset = end == std::string::npos ? url.size() : end;
+  const std::string_view authority(url.data() + start, origin.pathOffset - start);
+  const size_t colon = authority.find(':');
+  const std::string_view host = authority.substr(0, colon);
+  if (host.empty()) return false;
+  for (unsigned char c : host) {
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-' ||
+          c == '_'))
+      return false;
+  }
+  origin.host.assign(host);
+  for (char& c : origin.host) {
+    if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+  }
+  unsigned port = origin.scheme == "https" ? 443 : 80;
+  if (colon != std::string_view::npos) {
+    const auto value = authority.substr(colon + 1);
+    const auto parsed = std::from_chars(value.data(), value.data() + value.size(), port);
+    if (parsed.ec != std::errc{} || parsed.ptr != value.data() + value.size() || port == 0 || port > 65535)
+      return false;
+  }
+  origin.port = static_cast<uint16_t>(port);
+  return true;
+}
+
+inline std::string httpOrigin(const std::string& url) {
+  HttpOrigin origin;
+  if (!parseHttpOrigin(url, origin)) return {};
+  return origin.scheme + "://" + origin.host + ":" + std::to_string(origin.port);
+}
+
+}  // namespace freeink
