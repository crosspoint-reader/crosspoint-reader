diff --git a/libs/network/SecureNet/test/host/test_resumable_fetch.cpp b/libs/network/SecureNet/test/host/test_resumable_fetch.cpp
index b7809fb..216571d 100644
--- a/libs/network/SecureNet/test/host/test_resumable_fetch.cpp
+++ b/libs/network/SecureNet/test/host/test_resumable_fetch.cpp
@@ -214,5 +214,36 @@ int main() {
   r = get("http://a/f", sink());
   assert(!r.complete && r.bytes == 5);
 
+  // OTA refuses plaintext before connecting, including redirects and explicit downgrade options.
+  FetchOptions verified;
+  verified.requireHttps = true;
+  reset({"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"});
+  r = get("http://a/f", sink(), verified);
+  assert(!r.complete && r.status == -1 && FakeNet::requests().empty() && body.empty());
+  for (bool downgrade : {false, true}) {
+    verified.redirectToHttp = downgrade;
+    reset({"HTTP/1.1 302 Found\r\nLocation: http://b/g\r\nContent-Length: 0\r\n\r\n"});
+    r = get("https://a/f", sink(), verified);
+    assert(!r.complete && r.status == -1 && FakeNet::requests().size() == 1 && body.empty());
+  }
+  for (const char* url : {"HTTPS://a/f", "HtTpS://a/f"}) {
+    verified.redirectToHttp = false;
+    reset({"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"});
+    r = get(url, sink(), verified);
+    assert(r.complete && body == "ok");
+  }
+  reset({"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"});
+  r = get("HTTP://a/f", sink(), verified);
+  assert(!r.complete && r.status == -1 && FakeNet::requests().empty());
+  verified.redirectToHttp = false;
+  reset({"HTTP/1.1 302 Found\r\nLocation: HTTPS://b/g\r\nContent-Length: 0\r\n\r\n",
+         "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"});
+  r = get("https://a/f", sink(), verified);
+  assert(r.complete && body == "ok" && sentAuth(0) && !sentAuth(1));
+  reset({"HTTP/1.1 302 Found\r\nLocation: https://a:443/other\r\nContent-Length: 0\r\n\r\n",
+         "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"});
+  r = get("https://a/f", sink(), verified);
+  assert(r.complete && sentAuth(0) && sentAuth(1) && FakeNet::hosts()[1] == "a");
+
   puts("resumable fetch ok");
 }
