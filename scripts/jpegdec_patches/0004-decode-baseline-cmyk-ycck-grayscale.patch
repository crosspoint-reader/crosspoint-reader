+// Convert the four 8x8 component blocks in place for grayscale output.
+static int JPEGClampByte(int value)
+{
+    return value < 0 ? 0 : (value > 255 ? 255 : value);
+}
+
+static void JPEGCMYKToGray(JPEGIMAGE *pJPEG, int count)
+{
+    uint8_t *c = (uint8_t *)&pJPEG->sMCUs[MCU0];
+    const uint8_t *m = (uint8_t *)&pJPEG->sMCUs[MCU1];
+    const uint8_t *y = (uint8_t *)&pJPEG->sMCUs[MCU2];
+    const uint8_t *k = (uint8_t *)&pJPEG->sMCUs[MCU3];
+    for (int i = 0; i < count; i++) {
+        int r, g, b, black = k[i];
+        if (pJPEG->ucAdobeTransform == 2) { // YCCK stores YCbCr of non-inverted CMY
+            const int cb = m[i] - 128, cr = y[i] - 128;
+            r = 255 - JPEGClampByte(c[i] + ((91881 * cr + 32768) >> 16));
+            g = 255 - JPEGClampByte(c[i] + ((-22554 * cb - 46802 * cr + 32768) >> 16));
+            b = 255 - JPEGClampByte(c[i] + ((116130 * cb + 32768) >> 16));
+        } else if (pJPEG->ucAdobeTransform == 0) { // Adobe CMYK is inverted
+            r = c[i]; g = m[i]; b = y[i];
+        } else { // conventional CMYK without APP14
+            r = 255 - c[i]; g = 255 - m[i]; b = 255 - y[i];
+            black = 255 - black;
+        }
+        // BT.601 luma times K, rounded; the numerator fits in uint32_t.
+        c[i] = (uint8_t)(((uint32_t)(19595 * r + 38470 * g + 7471 * b) * black + 8355840u) / 16711680u);
+    }
+}
+
