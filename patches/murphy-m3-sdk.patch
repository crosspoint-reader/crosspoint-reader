+#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/freeink-murphy-touch.XXXXXX")
+trap 'rm -rf "$BUILD_DIR"' EXIT
+c++ -std=c++17 -Wall -Wextra -Werror -Wno-unused-parameter \
+  -DFREEINK_DEVICE_MURPHY=1 -DARDUINO_USB_CDC_ON_BOOT=1 \
+  -Imurphy_stubs -Ipicco_stubs -I../../include -I../../../BoardConfig/include \
+  test_murphy.cpp ../../src/InputManager.cpp -o "$BUILD_DIR/test"
+"$BUILD_DIR/test"
diff --git a/libs/hardware/InputManager/test/host/test_murphy.cpp b/libs/hardware/InputManager/test/host/test_murphy.cpp
new file mode 100644
index 0000000..1a42399
--- /dev/null
+++ b/libs/hardware/InputManager/test/host/test_murphy.cpp
@@ -0,0 +1,48 @@
+#include <InputManager.h>
+#include <Wire.h>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+
+static void sample(InputManager& input, bool down, uint8_t x=24, uint16_t y=24) {
+  Wire.frame.assign(16, 0);
+  Wire.frame[3] = down ? 0x80 : 0;
+  Wire.frame[4] = x;
+  Wire.frame[5] = y >> 8;
+  Wire.frame[6] = y & 0xff;
+  fakeNow += 10;
+  input.update();
+}
+
+int main() {
+  static_assert(FREEINK_SD_SDMMC, "Murphy must compile the SDMMC backend");
+  static_assert(BoardConfig::MURPHY_M3.sdmmc.busWidth == 4);
+  static_assert(BoardConfig::MURPHY_M3.sdmmc.clk == 16);
+  static_assert(BoardConfig::MURPHY_M3.sdmmc.cmd == 17);
+  static_assert(BoardConfig::MURPHY_M3.sd.powerEnable == 10);
+  static_assert(!BoardConfig::MURPHY_M3.sd.powerActiveHigh);
+  static_assert(BoardConfig::MURPHY_M3.batteryDividerMultiplier == 2.0f);
+  gpioLevels[0] = gpioLevels[1] = gpioLevels[2] = HIGH;
+  BoardConfig::holdPowerRails();
+  InputManager input;
+  input.begin();
+  assert(Wire.began && Wire.timeout == 10);
+  sample(input, true);
+  assert(input.wasTouchPressed());
+  float x=0, y=0;
+  assert(input.wasTouchPressedAt(x,y));
+  assert(x == 0.0f && y == 1.0f);
+  unsigned taps=0;
+  for (int i=0; i<20; ++i) {
+    sample(input, false);
+    if (input.wasTouchTap(x,y)) ++taps;
+    assert(!input.wasAnyPressed());
+  }
+  assert(taps == 1);
+  sample(input, true, 224, 398);
+  assert(input.wasTouchPressedAt(x,y));
+  assert(x == 1.0f && y == 0.0f);
+  for (int i=0; i<20; ++i) sample(input, false);
+  assert(!input.isTouchPressed());
+  std::puts("Murphy board/touch tests passed");
+}
